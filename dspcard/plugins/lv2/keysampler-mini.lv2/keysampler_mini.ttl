@prefix atom: <http://lv2plug.in/ns/ext/atom#> .
@prefix doap: <http://usefulinc.com/ns/doap#> .
@prefix foaf: <http://xmlns.com/foaf/0.1/> .
@prefix lv2:  <http://lv2plug.in/ns/lv2core#> .
@prefix midi: <http://lv2plug.in/ns/ext/midi#> .
@prefix rdf:  <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix urid: <http://lv2plug.in/ns/ext/urid#> .

<https://github.com/keysampler/KeySamplerMini>
    a lv2:InstrumentPlugin, lv2:Plugin ;
    doap:name "KeySampler-mini" ;
    doap:maintainer [
        foaf:name "KeySampler" ;
    ] ;
    doap:license "Freeware: fatbit EULA (LICENSE.txt)" ;
    lv2:minorVersion 2 ;
    lv2:microVersion 0 ;
    rdfs:comment "Captures the bus input into memory and plays it chromatically from a MIDI keyboard (reduced version)." ;
    lv2:requiredFeature urid:map ;
    lv2:port
    [
        a lv2:InputPort, atom:AtomPort ;
        atom:bufferType atom:Sequence ;
        atom:supports midi:MidiEvent ;
        lv2:designation lv2:control ;
        lv2:index 0 ;
        lv2:symbol "events" ;
        lv2:name "Events" ;
    ] ,
    [
        a lv2:OutputPort, lv2:AudioPort ;
        lv2:index 1 ;
        lv2:symbol "audio_out_l" ;
        lv2:name "Audio Output Left" ;
    ] ,
    [
        a lv2:OutputPort, lv2:AudioPort ;
        lv2:index 2 ;
        lv2:symbol "audio_out_r" ;
        lv2:name "Audio Output Right" ;
    ] ,
    [
        a lv2:InputPort, lv2:AudioPort ;
        lv2:index 3 ;
        lv2:symbol "audio_in_l" ;
        lv2:name "Audio Input Left" ;
    ] ,
    [
        a lv2:InputPort, lv2:AudioPort ;
        lv2:index 4 ;
        lv2:symbol "audio_in_r" ;
        lv2:name "Audio Input Right" ;
    ] ,
    [
        a lv2:InputPort, lv2:ControlPort ;
        lv2:index 5 ;
        lv2:symbol "thru" ;
        lv2:name "Bus Capture" ;
        lv2:default 2 ;
        lv2:minimum 0 ;
        lv2:maximum 2 ;
        lv2:portProperty lv2:integer, lv2:enumeration ;
        lv2:scalePoint [ rdfs:label "Off" ; rdf:value 0 ] ,
                       [ rdfs:label "On Mute" ; rdf:value 1 ] ,
                       [ rdfs:label "On" ; rdf:value 2 ] ;
    ] ,
    [
        a lv2:InputPort, lv2:ControlPort ;
        lv2:index 6 ;
        lv2:symbol "mode" ;
        lv2:name "Mode" ;
        lv2:default 1 ;
        lv2:minimum 0 ;
        lv2:maximum 2 ;
        lv2:portProperty lv2:integer, lv2:enumeration ;
        lv2:scalePoint [ rdfs:label "One Shot" ; rdf:value 0 ] ,
                       [ rdfs:label "Gate" ; rdf:value 1 ] ,
                       [ rdfs:label "Loop" ; rdf:value 2 ] ;
    ] ,
    [
        a lv2:InputPort, lv2:ControlPort ;
        lv2:index 7 ;
        lv2:symbol "level" ;
        lv2:name "Level" ;
        lv2:default 1.0 ;
        lv2:minimum 0.0 ;
        lv2:maximum 2.0 ;
    ] ,
    [
        a lv2:InputPort, lv2:ControlPort ;
        lv2:index 8 ;
        lv2:symbol "tune" ;
        lv2:name "Tune" ;
        lv2:default 0.0 ;
        lv2:minimum -24.0 ;
        lv2:maximum 24.0 ;
    ] ,
    [
        a lv2:InputPort, lv2:ControlPort ;
        lv2:index 9 ;
        lv2:symbol "filter" ;
        lv2:name "Low Pass" ;
        lv2:default 0 ;
        lv2:minimum 0 ;
        lv2:maximum 1 ;
        lv2:portProperty lv2:toggled ;
    ] ,
    [
        a lv2:InputPort, lv2:ControlPort ;
        lv2:index 10 ;
        lv2:symbol "cutoff" ;
        lv2:name "Cutoff" ;
        lv2:default 100.0 ;
        lv2:minimum 0.0 ;
        lv2:maximum 100.0 ;
    ] ,
    [
        a lv2:InputPort, lv2:ControlPort ;
        lv2:index 11 ;
        lv2:symbol "resonance" ;
        lv2:name "Resonance" ;
        lv2:default 0.0 ;
        lv2:minimum 0.0 ;
        lv2:maximum 1.0 ;
    ] ,
    [
        a lv2:InputPort, lv2:ControlPort ;
        lv2:index 12 ;
        lv2:symbol "fenv_amount" ;
        lv2:name "F.Env Amount" ;
        lv2:default 0.0 ;
        lv2:minimum -100.0 ;
        lv2:maximum 100.0 ;
    ] ,
    [
        a lv2:InputPort, lv2:ControlPort ;
        lv2:index 13 ;
        lv2:symbol "fenv_attack" ;
        lv2:name "F.Env Attack ms" ;
        lv2:default 5.0 ;
        lv2:minimum 0.0 ;
        lv2:maximum 2000.0 ;
    ] ,
    [
        a lv2:InputPort, lv2:ControlPort ;
        lv2:index 14 ;
        lv2:symbol "fenv_decay" ;
        lv2:name "F.Env Decay ms" ;
        lv2:default 300.0 ;
        lv2:minimum 0.0 ;
        lv2:maximum 5000.0 ;
    ] ,
    [
        a lv2:InputPort, lv2:ControlPort ;
        lv2:index 15 ;
        lv2:symbol "fenv_sustain" ;
        lv2:name "F.Env Sustain" ;
        lv2:default 0.2 ;
        lv2:minimum 0.0 ;
        lv2:maximum 1.0 ;
    ] ,
    [
        a lv2:InputPort, lv2:ControlPort ;
        lv2:index 16 ;
        lv2:symbol "fenv_release" ;
        lv2:name "F.Env Release ms" ;
        lv2:default 300.0 ;
        lv2:minimum 0.0 ;
        lv2:maximum 5000.0 ;
    ] ,
    [
        a lv2:InputPort, lv2:ControlPort ;
        lv2:index 17 ;
        lv2:symbol "lfo_wave" ;
        lv2:name "LFO Wave" ;
        lv2:default 0 ;
        lv2:minimum 0 ;
        lv2:maximum 4 ;
        lv2:portProperty lv2:integer, lv2:enumeration ;
        lv2:scalePoint [ rdfs:label "Sine" ; rdf:value 0 ] ,
                       [ rdfs:label "Triangle" ; rdf:value 1 ] ,
                       [ rdfs:label "Square" ; rdf:value 2 ] ,
                       [ rdfs:label "Saw" ; rdf:value 3 ] ,
                       [ rdfs:label "Random" ; rdf:value 4 ] ;
    ] ,
    [
        a lv2:InputPort, lv2:ControlPort ;
        lv2:index 18 ;
        lv2:symbol "lfo_rate" ;
        lv2:name "LFO Rate Hz" ;
        lv2:default 5.0 ;
        lv2:minimum 0.1 ;
        lv2:maximum 12.0 ;
    ] ,
    [
        a lv2:InputPort, lv2:ControlPort ;
        lv2:index 19 ;
        lv2:symbol "lfo_depth" ;
        lv2:name "LFO Depth" ;
        lv2:default 0.0 ;
        lv2:minimum 0.0 ;
        lv2:maximum 100.0 ;
    ] ,
    [
        a lv2:InputPort, lv2:ControlPort ;
        lv2:index 20 ;
        lv2:symbol "lfo_delay" ;
        lv2:name "LFO Delay ms" ;
        lv2:default 0.0 ;
        lv2:minimum 0.0 ;
        lv2:maximum 2000.0 ;
    ] ,
    [
        a lv2:InputPort, lv2:ControlPort ;
        lv2:index 21 ;
        lv2:symbol "attack" ;
        lv2:name "Attack ms" ;
        lv2:default 1.0 ;
        lv2:minimum 0.0 ;
        lv2:maximum 2000.0 ;
    ] ,
    [
        a lv2:InputPort, lv2:ControlPort ;
        lv2:index 22 ;
        lv2:symbol "decay" ;
        lv2:name "Decay ms" ;
        lv2:default 200.0 ;
        lv2:minimum 0.0 ;
        lv2:maximum 5000.0 ;
    ] ,
    [
        a lv2:InputPort, lv2:ControlPort ;
        lv2:index 23 ;
        lv2:symbol "sustain" ;
        lv2:name "Sustain" ;
        lv2:default 1.0 ;
        lv2:minimum 0.0 ;
        lv2:maximum 1.0 ;
    ] ,
    [
        a lv2:InputPort, lv2:ControlPort ;
        lv2:index 24 ;
        lv2:symbol "release" ;
        lv2:name "Release ms" ;
        lv2:default 150.0 ;
        lv2:minimum 0.0 ;
        lv2:maximum 5000.0 ;
    ] ,
    [
        a lv2:InputPort, lv2:ControlPort ;
        lv2:index 25 ;
        lv2:symbol "ks_pan" ;
        lv2:name "Pan" ;
        lv2:default 0.0 ;
        lv2:minimum -1.0 ;
        lv2:maximum 1.0 ;
    ] ,
    [
        a lv2:InputPort, lv2:ControlPort ;
        lv2:index 26 ;
        lv2:symbol "midi_ch" ;
        lv2:name "MIDI Channel" ;
        lv2:default 0 ;
        lv2:minimum 0 ;
        lv2:maximum 16 ;
        lv2:portProperty lv2:integer, lv2:enumeration ;
        lv2:scalePoint [ rdfs:label "Omni" ; rdf:value 0 ] ,
                       [ rdfs:label "1" ; rdf:value 1 ] ,
                       [ rdfs:label "2" ; rdf:value 2 ] ,
                       [ rdfs:label "3" ; rdf:value 3 ] ,
                       [ rdfs:label "4" ; rdf:value 4 ] ,
                       [ rdfs:label "5" ; rdf:value 5 ] ,
                       [ rdfs:label "6" ; rdf:value 6 ] ,
                       [ rdfs:label "7" ; rdf:value 7 ] ,
                       [ rdfs:label "8" ; rdf:value 8 ] ,
                       [ rdfs:label "9" ; rdf:value 9 ] ,
                       [ rdfs:label "10" ; rdf:value 10 ] ,
                       [ rdfs:label "11" ; rdf:value 11 ] ,
                       [ rdfs:label "12" ; rdf:value 12 ] ,
                       [ rdfs:label "13" ; rdf:value 13 ] ,
                       [ rdfs:label "14" ; rdf:value 14 ] ,
                       [ rdfs:label "15" ; rdf:value 15 ] ,
                       [ rdfs:label "16" ; rdf:value 16 ] ;
    ] ,
    [
        a lv2:InputPort, lv2:ControlPort ;
        lv2:index 27 ;
        lv2:symbol "velsens" ;
        lv2:name "Vel Sens" ;
        lv2:default 1.0 ;
        lv2:minimum 0.0 ;
        lv2:maximum 1.0 ;
    ] ,
    [
        a lv2:InputPort, lv2:ControlPort ;
        lv2:index 28 ;
        lv2:symbol "bend" ;
        lv2:name "Bend Range" ;
        lv2:default 2 ;
        lv2:minimum 0 ;
        lv2:maximum 24 ;
        lv2:portProperty lv2:integer ;
    ] ,
    [
        a lv2:InputPort, lv2:ControlPort ;
        lv2:index 29 ;
        lv2:symbol "start_sec" ;
        lv2:name "Start sec" ;
        lv2:default 0 ;
        lv2:minimum 0 ;
        lv2:maximum 59 ;
        lv2:portProperty lv2:integer ;
    ] ,
    [
        a lv2:InputPort, lv2:ControlPort ;
        lv2:index 30 ;
        lv2:symbol "start_msec" ;
        lv2:name "Start ms" ;
        lv2:default 0 ;
        lv2:minimum 0 ;
        lv2:maximum 999 ;
        lv2:portProperty lv2:integer ;
    ] ,
    [
        a lv2:InputPort, lv2:ControlPort ;
        lv2:index 31 ;
        lv2:symbol "loop_start_sec" ;
        lv2:name "Loop Start sec" ;
        lv2:default 0 ;
        lv2:minimum 0 ;
        lv2:maximum 59 ;
        lv2:portProperty lv2:integer ;
    ] ,
    [
        a lv2:InputPort, lv2:ControlPort ;
        lv2:index 32 ;
        lv2:symbol "loop_start_msec" ;
        lv2:name "Loop Start ms" ;
        lv2:default 0 ;
        lv2:minimum 0 ;
        lv2:maximum 999 ;
        lv2:portProperty lv2:integer ;
    ] ,
    [
        a lv2:InputPort, lv2:ControlPort ;
        lv2:index 33 ;
        lv2:symbol "loop_end_sec" ;
        lv2:name "Loop End sec" ;
        lv2:default 0 ;
        lv2:minimum 0 ;
        lv2:maximum 59 ;
        lv2:portProperty lv2:integer ;
    ] ,
    [
        a lv2:InputPort, lv2:ControlPort ;
        lv2:index 34 ;
        lv2:symbol "loop_end_msec" ;
        lv2:name "Loop End ms" ;
        lv2:default 0 ;
        lv2:minimum 0 ;
        lv2:maximum 999 ;
        lv2:portProperty lv2:integer ;
    ] ,
    [
        a lv2:InputPort, lv2:ControlPort ;
        lv2:index 35 ;
        lv2:symbol "root" ;
        lv2:name "Root Note" ;
        lv2:default 60 ;
        lv2:minimum 0 ;
        lv2:maximum 127 ;
        lv2:portProperty lv2:integer ;
    ] .
